    "test:stress": "tsx tests/stress.ts",
    "test:modular": "node tests/modular.mjs",
    "test:race": "node tests/race-browser.mjs",
    "test:run": "node tests/run-browser.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/three": "0.185.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
